  background: var(--color-warning);
}

.array-bar.is-swapping {
  background: var(--color-danger);
  transform: translateY(-8px);
}

.array-bar.is-sorted {
  background: var(--color-success);
}

/* other styling */
.toolbar {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-bottom: 2rem;
}

.toolbar__row {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

button {
  padding: 0.7rem 1.2rem;
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}
